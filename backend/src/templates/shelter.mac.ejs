! ============================================================
! AeroTwin-Habitat — ANSYS APDL Thermal Analysis Macro
! Generated by AeroTwin-Habitat Report Service
! Shelter: <%- shelterName %>
! Location: <%- locationName %> (<%- lat %>°N, <%- lon %>°E, <%- altitude_m %> m ASL)
! Run ID: <%- runId %>
! Generated: <%- generatedAt %>
! Project: SIH26054 — High-Altitude Military Shelter Analysis
! ============================================================
! INSTRUCTIONS:
!   1. Open ANSYS Mechanical APDL 2023 R1+
!   2. File > Read Input from > select this .mac file
!   3. Review and adjust material properties if needed
!   4. Run /SOLVE
! ============================================================

/BATCH
/TITLE, AeroTwin-Habitat Shelter Thermal Analysis: <%- shelterName %>
/UNITS, SI

! ── PREPROCESSOR ─────────────────────────────────────────────
/PREP7

! ─ Element Type ──────────────────────────────────────────────
! PLANE55: 2D 4-node thermal solid element
ET,1,PLANE55

! ─ Material Properties ───────────────────────────────────────
! Material 1: Roof (<%- roofMaterial %>)
MP,KXX,1,<%- roofConductivity %>     ! Thermal conductivity W/(m·K)
MP,C,1,<%- roofSpecificHeat %>        ! Specific heat J/(kg·K)
MP,DENS,1,<%- roofDensity %>          ! Density kg/m³

! Material 2: Walls (<%- wallMaterial %>)
MP,KXX,2,<%- wallConductivity %>
MP,C,2,<%- wallSpecificHeat %>
MP,DENS,2,<%- wallDensity %>

! Material 3: Floor (<%- floorMaterial %>)
MP,KXX,3,<%- floorConductivity %>
MP,C,3,<%- floorSpecificHeat %>
MP,DENS,3,<%- floorDensity %>

<% if (hasPcm) { %>
! Material 4: PCM Layer (melt point <%- pcmMeltPoint %>°C, L=<%- pcmLatentHeat %> kJ/kg)
! Apparent heat capacity implemented via temperature-dependent specific heat
MP,KXX,4,0.20                          ! PCM thermal conductivity (approx)
MP,DENS,4,800                           ! PCM density (kg/m³, paraffin approx)
! Temperature-dependent C (J/kg·K) — Gaussian peak at melt point
! Note: Define via MPTEMP/MPDATA for full apparent cp curve
MPTEMP,,<%- pcmMeltPoint - 10 %>,<%- pcmMeltPoint - 3 %>,<%- pcmMeltPoint - 1 %>,<%- pcmMeltPoint %>,<%- pcmMeltPoint + 1 %>,<%- pcmMeltPoint + 3 %>,<%- pcmMeltPoint + 10 %>
MPDATA,C,4,,840,840,<%- pcmPeakCp %>,<%- pcmPeakCp * 2 %>,<%- pcmPeakCp %>,840,840
<% } %>

! ─ Geometry ──────────────────────────────────────────────────
! 2D Cross-section (XY plane): shelter wall section
! X = depth through wall, Y = height
! Length = <%- length_m %> m, Width = <%- width_m %> m, Height = <%- height_m %> m

! --- Roof layer keypoints (horizontal cross-section) ---
K,1, 0.0,     <%- height_m %>
K,2, <%- roofThickness %>, <%- height_m %>
K,3, <%- roofThickness %>, <%- height_m + roofThickness %>
K,4, 0.0,     <%- height_m + roofThickness %>

! --- Wall layer keypoints (vertical cross-section) ---
K,5, -<%- wallThickness %>, 0.0
K,6, 0.0,                   0.0
K,7, 0.0,                   <%- height_m %>
K,8, -<%- wallThickness %>, <%- height_m %>

! --- Floor layer keypoints ---
K,9,  0.0,                -<%- floorThickness %>
K,10, <%- length_m %>,    -<%- floorThickness %>
K,11, <%- length_m %>,     0.0
K,12, 0.0,                  0.0

! ─ Areas ─────────────────────────────────────────────────────
! Roof area
A,1,2,3,4

! Wall area
A,5,6,7,8

! Floor area
A,9,10,11,12

! ─ Meshing ───────────────────────────────────────────────────
ESIZE,<%- meshSize %>     ! Element size (m)

! Roof mesh (Material 1)
MAT,1
AMESH,1

! Wall mesh (Material 2)
MAT,2
AMESH,2

! Floor mesh (Material 3)
MAT,3
AMESH,3

FINISH

! ── SOLUTION ──────────────────────────────────────────────────
/SOLU

! Transient thermal analysis
ANTYPE,TRANS
TRNOPT,FULL            ! Full transient
TIMINT,ON              ! Time integration ON
KBC,0                  ! Ramped loads

! Time settings: 24-hour simulation with 300s (5 min) steps
TIME,86400             ! Total time (seconds) = 24 hours
DELTIM,300,60,600      ! Timestep: nominal 300s, min 60s, max 600s
AUTOTS,ON              ! Automatic time stepping
OUTRES,ALL,LAST        ! Save results every step

! ─ Boundary Conditions ───────────────────────────────────────
! Exterior surface: convective BC (outdoor air)
! Heat transfer coefficient h_ext = <%- h_ext %> W/(m²·K)
! Ambient temperature = <%- T_ambient_C %>°C (representative)
NSEL,S,LOC,X,-<%- wallThickness %>
SF,ALL,CONV,<%- h_ext %>,<%- T_ambient_C %>
NSEL,ALL

! Roof exterior: convective + solar (solar load as heat flux)
NSEL,S,LOC,Y,<%- height_m + roofThickness %>
SF,ALL,CONV,<%- h_ext %>,<%- T_ambient_C %>
! Solar heat flux on roof (peak DNI × absorptivity ≈ 0.9)
SFE,ALL,1,HFLUX,,<%- solarPeakFlux %>
NSEL,ALL

! Floor exterior: ground temperature BC
NSEL,S,LOC,Y,-<%- floorThickness %>
D,ALL,TEMP,<%- T_ground_C %>
NSEL,ALL

! Interior surfaces: convective BC (indoor air)
NSEL,S,LOC,X,0.0
SF,ALL,CONV,<%- h_int %>,<%- T_indoor_init_C %>
NSEL,ALL

! ─ Initial Conditions ─────────────────────────────────────────
TUNIF,<%- T_init_C %>   ! Uniform initial temperature (°C)

! ─ Solve ─────────────────────────────────────────────────────
SOLVE
FINISH

! ── POSTPROCESSOR ─────────────────────────────────────────────
/POST1

! Read last time step
SET,LAST

! Plot temperature distribution
PLNSOL,TEMP,,0,1.0

! List maximum and minimum temperatures
PRNSOL,TEMP,PRINT

! Reaction heat flows at boundaries
PRESOL,HEAT

/EOF
