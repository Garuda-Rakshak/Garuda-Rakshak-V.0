# ─── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/aerotwin_habitat

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_string_at_least_64_chars
JWT_EXPIRES_IN=7d

# ─── File Storage (local, relative to project root) ──────
REPORTS_DIR=./reports
EXPORTS_DIR=./exports
